# Krishi Connect Environment Variables Example

# Secret key for Flask sessions
SECRET_KEY=your-super-secret-key-change-me

# Database URI (defaults to SQLite if not provided)
# DATABASE_URL=postgresql://user:password@localhost/krishiconnect

# Mail Server Configurations for OTP Sending
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_DEFAULT_SENDER=your-email@gmail.com
